[Unit]
Description=Hermes Agent Dashboard (Kanban)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.hermes/hermes-agent/venv/bin/hermes dashboard --host 0.0.0.0 --insecure --port 9119 --no-open
Restart=always
RestartSec=5
Environment=HOME=%h
Environment=PATH=%h/.local/bin:%h/.hermes/hermes-agent/venv/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
