+            # hand-repaired). A window keeps just-written objects safe.
+            ["gc", "--prune=2.hours.ago", "--quiet"],
             store, str(store.parent), timeout=_GIT_TIMEOUT * 3,
         )
         _repair_bare_repo_dirs(store)
@@ -1412,7 +1429,12 @@ def prune_checkpoints(
